{
  "name": "indonesian-poker-game",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer Indonesian Poker (Capsa Banting) 4-player web card game",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run --prefix server dev",
    "dev:client": "npm run --prefix client dev",
    "build": "npm run --prefix client build",
    "build:client": "npm run --prefix client build",
    "start:server": "npm run --prefix server start",
    "test": "npm run --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
